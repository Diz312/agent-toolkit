# Copy to ~/.secrets/agent.env (chmod 600) on each machine and fill in the keys you use.
# skillshare writes only ${VAR} references into harness configs; the harness reads the value
# from its environment (~/.zshrc and the com.<user>.agent-env LaunchAgent load this file).
# `skillshare mcp check` reports any variable that is unset.

# context7: free key at https://context7.com/dashboard
CONTEXT7_API_KEY=
